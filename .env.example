# ─── OpenAI (default chatbot + judge) ────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Chatbot model override ───────────────────────────────────────────────────
# Leave these unset to use the OpenAI defaults (gpt-4o for all actions).
#
# To run the chatbot on a local Ollama model instead, set both variables:
#
#   CHATBOT_MODEL=gemma4:e2b
#   CHATBOT_BASE_URL=http://localhost:11434/v1
#
# Use `just eval-gemma2b` or `just eval-gemma4b` as shortcuts — they set
# these variables automatically without requiring changes to this file.
#
# CHATBOT_MODEL=gpt-4o
# CHATBOT_BASE_URL=
